{
  "name": "vishnu-edu",
  "private": true,
  "packageManager": "pnpm@10.30.3",
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "lint": "eslint .",
    "format": "prettier --write .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:e2e": "playwright test",
    "db:generate": "pnpm --filter @edu/db generate",
    "db:migrate": "tsx packages/db/src/migrate.ts"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "eslint": "^9.39.0",
    "typescript-eslint": "^8.56.0",
    "typescript": "^5.9.3",
    "prettier": "^3.8.1",
    "turbo": "^2.8.0",
    "tsx": "^4.21.0",
    "vitest": "^3.2.4",
    "@playwright/test": "^1.58.0",
    "@testcontainers/postgresql": "^11.12.0",
    "@types/node": "^26.6.3",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/pg": "^8.16.0",
    "dotenv": "^17.3.0"
  },
  "dependencies": {
    "zod": "^3.25.76",
    "pg": "^8.18.0",
    "uuid": "^11.1.0",
    "drizzle-orm": "^0.45.1",
    "ioredis": "^5.9.0",
    "pino": "^9.14.0",
    "pg-boss": "^10.4.2",
    "react": "^19.2.4",
    "react-dom": "^19.2.4"
  },
  "pnpm": {
    "overrides": {
      "pdfjs-dist": "5.3.93"
    }
  }
}
