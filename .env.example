# Copy to .env; never commit real credentials. Dev Compose ports are below.
# Runtime identity for web, realtime and worker: the restricted edu_app role (not a superuser,
# cannot bypass row-level security). `pnpm db:migrate` creates it and sets this password.
DATABASE_URL=postgresql://edu_app:change-me-app@localhost:5432/edu
# Table owner: used only by migrations and pg_dump backups.
MIGRATION_DATABASE_URL=postgresql://edu:change-me@localhost:5432/edu
REDIS_URL=redis://localhost:6379
# Generate with: openssl rand -hex 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
# One Google OAuth client for sign-in and for tutors' Google Calendar (enable the Calendar API).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Comma-separated verified Google email addresses; evaluated at sign-in.
ADMIN_EMAILS=owner@example.com
# Test helper only. Production startup throws if set to 1.
E2E_AUTH_BYPASS=0
RESEND_API_KEY=
EMAIL_FROM=EDU <noreply@example.com>
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=local-dev
R2_SECRET_ACCESS_KEY=local-dev
R2_BUCKET=edu
# Cloudflare: https://<account-id>.r2.cloudflarestorage.com ; local S3-compatible store (dev Compose) below
R2_ENDPOINT=http://localhost:9000
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# Local/CI e2e only: 1 creates fake order ids instead of calling Razorpay. Web refuses to start with it in production.
PAYMENTS_STUB=
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_REALTIME_URL=http://localhost:3001
REALTIME_PORT=3001
SENTRY_DSN=
BACKUP_R2_BUCKET=edu-backups
# Compose database bootstrap credentials; match the URLs above.
APP_DB_PASSWORD=
POSTGRES_PASSWORD=change-me
# Production Caddy host and certificate contact.
APP_DOMAIN=edu.vishnugandarapu.in
ACME_EMAIL=admin@example.com
# CI integration tests use isolated PostgreSQL 16 Testcontainers when set to 1.
USE_TESTCONTAINERS=0
